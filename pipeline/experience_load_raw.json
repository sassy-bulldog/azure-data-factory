{
	"name": "experience_load_raw",
	"properties": {
		"description": "Weekly load from the Northern Re database",
		"activities": [
			{
				"name": "bau_nore_raw",
				"description": "Converts the JSON output of the financial model inputs into the standardized layout of the data lake",
				"type": "ExecuteDataFlow",
				"dependsOn": [
					{
						"activity": "Get NoRe Data",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataflow": {
						"referenceName": "bau_nore_raw",
						"type": "DataFlowReference",
						"parameters": {
							"queryDate": {
								"value": "'@{variables('queryDate')}'",
								"type": "Expression"
							}
						},
						"datasetParameters": {
							"source1": {
								"json_FileName": {
									"value": "@{variables('queryDate')}.json",
									"type": "Expression"
								}
							},
							"sink1": {
								"FileName": {
									"value": "@{variables('queryDate')}.parquet",
									"type": "Expression"
								}
							}
						}
					},
					"compute": {
						"coreCount": 8,
						"computeType": "General"
					},
					"traceLevel": "Fine"
				}
			},
			{
				"name": "Get NoRe Data",
				"description": "Extract Nothern Re data from Databricks",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Set queryDate",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Get Northern Re Secrets",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "bau_nore",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"DatabricksInstance": "6792391718158368.8",
						"DatabricksWarehouse": "2567c85ef27cadcd",
						"DatabricksCatalog": "investor_jaffa",
						"DatabricksSchema": "default",
						"DatabricksQuery": "SELECT * FROM financial_model_inputs",
						"queryDate": {
							"value": "@variables('queryDate')",
							"type": "Expression"
						},
						"TenantID": "ca024c7e-927f-4b78-9fcb-aae554c6ade1",
						"ClientID": "c748753e-a9b8-42e7-8e81-37d5df61472a",
						"ResourceID": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d"
					}
				}
			},
			{
				"name": "Set queryDate",
				"description": "Captures the pipeline trigger time as the query date for future use.",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "queryDate",
					"value": {
						"value": "@concat(\n    formatDateTime(\n        coalesce(pipeline().TriggerTime, utcNow()), \n        'yyyy-MM-dd''T''HH:mm:ss'\n    ),\n    'Z'\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Northern Re Secrets",
				"description": "Should return the parameters needed to extract data from Northern Re",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "nore_secrets",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			}
		],
		"variables": {
			"queryDate": {
				"type": "String",
				"defaultValue": "2025-08-02T01:00:00.6909793Z"
			}
		},
		"folder": {
			"name": "Jaffa/Financial Model Inputs"
		},
		"annotations": [],
		"lastPublishTime": "2025-05-30T21:01:59Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}