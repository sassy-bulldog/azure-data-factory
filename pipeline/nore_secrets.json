{
	"name": "nore_secrets",
	"properties": {
		"description": "Get the secrets associated with Northern Re data",
		"activities": [
			{
				"name": "List Secrets",
				"description": "Gets the ClientID from Azure Key Vault",
				"type": "WebActivity",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "GET",
					"linkedServices": [
						{
							"referenceName": "AzureKeyVault_NorthernRe",
							"type": "LinkedServiceReference"
						}
					],
					"url": "https://northernredatabricks.vault.azure.net/secrets?api-version=7.5",
					"authentication": {
						"type": "MSI",
						"resource": "https://vault.azure.net"
					}
				}
			},
			{
				"name": "For Each Secret",
				"description": "Iterate over the secrets and extract the key value pairs for use in later pipelines",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "List Secrets",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('List Secrets').output.value",
						"type": "Expression"
					},
					"activities": [
						{
							"name": "Get Secret Value",
							"description": "Get the value for the current secret being iterated over",
							"type": "WebActivity",
							"dependsOn": [],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"method": "GET",
								"linkedServices": [
									{
										"referenceName": "AzureKeyVault_NorthernRe",
										"type": "LinkedServiceReference"
									}
								],
								"url": {
									"value": "@concat(\n    item().id,\n    '?api-version=7.5'\n)",
									"type": "Expression"
								},
								"authentication": {
									"type": "MSI",
									"resource": "https://vault.azure.net"
								}
							}
						},
						{
							"name": "Append Secret",
							"description": "Append the secret key value pair to our output variable.",
							"type": "AppendVariable",
							"dependsOn": [
								{
									"activity": "Get Secret Value",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"userProperties": [],
							"typeProperties": {
								"variableName": "SecretDictionary",
								"value": {
									"value": "@json(\n    concat(\n        '{',\n        '\"name\": \"', last(split(string(item().id), '/')), '\",',\n        '\"value\": \"', string(activity('Get Secret Value').output.value), '\"',\n        '}'\n    )\n)",
									"type": "Expression"
								}
							}
						}
					]
				}
			},
			{
				"name": "Set Output",
				"description": "Returns the list of secret key value pairs to the parent flow",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "For Each Secret",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "pipelineReturnValue",
					"value": [
						{
							"key": "secrets",
							"value": {
								"type": "Object",
								"content": "@variables('SecretDictionary')"
							}
						}
					],
					"setSystemVariable": true
				}
			}
		],
		"variables": {
			"SecretDictionary": {
				"type": "Array"
			}
		},
		"folder": {
			"name": "NorthernRe/Financial Model Inputs"
		},
		"annotations": []
	}
}