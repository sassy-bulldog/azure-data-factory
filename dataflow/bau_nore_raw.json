{
	"name": "bau_nore_raw",
	"properties": {
		"folder": {
			"name": "Jaffa/Financial Model Inputs"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "nore_fmi_json_bom",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "fmi_parquet",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "flattenrows"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "assert1",
					"description": "Assert that now unique keys have duplicate records"
				},
				{
					"name": "flattenschema"
				},
				{
					"name": "crossjoin"
				}
			],
			"scriptLines": [
				"parameters{",
				"     queryDate as string ('2025-09-27T01:00:00.484978Z')",
				"}",
				"source(output(",
				"          statement_id as string,",
				"          status as (state as string),",
				"          manifest as (format as string, schema as (column_count as integer, columns as (name as string, type_text as string, type_name as string, position as integer)[]), total_chunk_count as integer, chunks as (chunk_index as integer, row_offset as integer, row_count as integer)[], total_row_count as integer, truncated as boolean),",
				"          result as (chunk_index as integer, row_offset as integer, row_count as integer, data_array as string[][])",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     moveFiles: ['inbox','bronze/northernre/treefrog_snapshots'],",
				"     documentForm: 'singleDocument') ~> source1",
				"source1 foldDown(unroll(result.data_array),",
				"     mapColumn(",
				"          statement_id,",
				"          status = status.state,",
				"          rows = result.data_array",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenrows",
				"crossjoin derive(nre_feed = rows[1],",
				"          bordereaux_month = toDate(rows[2],\"M/d/yy\"),",
				"          treaty_year = toInteger(rows[3]),",
				"          isAdmitted = equalsIgnoreCase(rows[4], \"Admitted\"),",
				"          tf_assumed_paid_ulae = toDecimal(replace(rows[5], ',', ''), 28, 2),",
				"          tf_assumed_paid_alae = toDecimal(replace(rows[6], ',', ''), 28, 2),",
				"          tf_assumed_collected_premium = toDecimal(replace(rows[7], ',', ''), 28, 2),",
				"          tf_assumed_earned_premium = toDecimal(replace(rows[8], ',', ''), 28, 2),",
				"          tf_assumed_gross_written_premium = toDecimal(replace(rows[9], ',', ''), 28, 2),",
				"          tf_assumed_paid_losses = toDecimal(replace(rows[10], ',', ''), 28, 2),",
				"          tf_assumed_expected_losses = toDecimal(replace(rows[11], ',', ''), 28, 2),",
				"          tf_assumed_ss = toDecimal(replace(rows[12], ',', ''), 28, 2),",
				"          v_created = case(\r",
				"    !isNull(toDate(rows[13])), toDate(rows[13]),\r",
				"    toDate(rows[13], 'M/d/yy')\r",
				"),",
				"          FileName = concat('/bronze/northernre/treefrog_snapshots/', rows[1], '/', rows[3], '/', $queryDate, '.parquet'),",
				"          query_date = toTimestamp(substring($queryDate, 0, 23) + 'Z', 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSS\\'Z\\'')) ~> derivedColumn1",
				"derivedColumn1 aggregate(groupBy(nre_feed,",
				"          isAdmitted,",
				"          treaty_year,",
				"          bordereaux_month),",
				"     row_count = count()) ~> aggregate1",
				"derivedColumn1, aggregate1 join(derivedColumn1@nre_feed == aggregate1@nre_feed",
				"     && derivedColumn1@isAdmitted == aggregate1@isAdmitted",
				"     && derivedColumn1@treaty_year == aggregate1@treaty_year",
				"     && derivedColumn1@bordereaux_month == aggregate1@bordereaux_month,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"assert1 select(mapColumn(",
				"          statement_id = flattenschema@statement_id,",
				"          status,",
				"          nre_feed = derivedColumn1@nre_feed,",
				"          isAdmitted = derivedColumn1@isAdmitted,",
				"          bordereaux_month = derivedColumn1@bordereaux_month,",
				"          treaty_year = derivedColumn1@treaty_year,",
				"          tf_assumed_paid_ulae,",
				"          tf_assumed_paid_alae,",
				"          tf_assumed_collected_premium,",
				"          tf_assumed_earned_premium,",
				"          tf_assumed_gross_written_premium,",
				"          tf_assumed_paid_losses,",
				"          tf_assumed_expected_losses,",
				"          tf_assumed_ss,",
				"          v_created,",
				"          FileName,",
				"          query_date",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 assert(expectTrue(row_count <= 1, false, 'assert1', row_count > 1, \"Unique key check failed\"),",
				"     expectTrue(!isNull(v_created), false, 'assert2', null, \"Assert that v_created is populated for all rows\"),",
				"     expectTrue(!isNull(query_date), false, 'assert3', null, \"Assert that query_date is populated for all rows\"),",
				"     expectTrue(!isNull(derivedColumn1@bordereaux_month), false, 'assert4', null, \"Assert that bordereaux_month is populated for all rows\"),",
				"     expectTrue(!isNull(derivedColumn1@nre_feed), false, 'assert5', null, \"Assert that nre_feed is populated for all rows\"),",
				"     expectTrue(!isNull(derivedColumn1@treaty_year), false, 'assert6', null, \"Assert that treaty_year is populated for all rows\"),",
				"     abort: true) ~> assert1",
				"source1 foldDown(unroll(manifest.schema.columns),",
				"     mapColumn(",
				"          statement_id,",
				"          name = manifest.schema.columns.name,",
				"          type_text = manifest.schema.columns.type_text,",
				"          type_name = manifest.schema.columns.type_name,",
				"          position = manifest.schema.columns.position",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenschema",
				"flattenschema, flattenrows join(flattenschema@statement_id == flattenrows@statement_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> crossjoin",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          nre_feed as string,",
				"          treaty_year as integer,",
				"          v_created as date,",
				"          query_date as timestamp,",
				"          bordereaux_month as date,",
				"          tf_assumed_gross_written_premium as decimal(10,2),",
				"          tf_assumed_earned_premium as decimal(10,2),",
				"          tf_assumed_paid_losses as decimal(10,2),",
				"          tf_assumed_expected_losses as decimal(10,2),",
				"          tf_assumed_collected_premium as decimal(10,2),",
				"          tf_assumed_ss as decimal(10,2),",
				"          tf_assumed_paid_alae as decimal(10,2),",
				"          tf_assumed_paid_ulae as decimal(10,2)",
				"     ),",
				"     format: 'parquet',",
				"     rowUrlColumn:'FileName',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}