{
	"name": "bau_nore_raw",
	"properties": {
		"folder": {
			"name": "Jaffa/Financial Model Inputs"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "nore_fmi_json_bom",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "fmi_parquet",
						"type": "DatasetReference"
					},
					"name": "sink1",
					"rejectedDataLinkedService": {
						"referenceName": "AzureDataLakeStorage",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [
				{
					"name": "flattenrows"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "aggregate1"
				},
				{
					"name": "join1"
				},
				{
					"name": "select1"
				},
				{
					"name": "assert1",
					"description": "Assert that now unique keys have duplicate records"
				},
				{
					"name": "flattenschema"
				},
				{
					"name": "crossjoin"
				},
				{
					"name": "pivot1"
				},
				{
					"name": "derivedValue"
				},
				{
					"name": "window1"
				},
				{
					"name": "fixColumnNames"
				},
				{
					"name": "cast1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     queryDate as string ('2025-11-15T02:00:01.2920241Z')",
				"}",
				"source(output(",
				"          statement_id as string,",
				"          status as (state as string),",
				"          manifest as (format as string, schema as (column_count as integer, columns as (name as string, type_text as string, type_name as string, position as integer)[]), total_chunk_count as integer, chunks as (chunk_index as integer, row_offset as integer, row_count as integer)[], total_row_count as integer, truncated as boolean),",
				"          result as (chunk_index as integer, row_offset as integer, row_count as integer, data_array as string[][])",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     moveFiles: ['inbox','bronze/northernre/treefrog_snapshots'],",
				"     documentForm: 'singleDocument') ~> source1",
				"source1 foldDown(unroll(result.data_array),",
				"     mapColumn(",
				"          statement_id,",
				"          status = status.state,",
				"          rows = result.data_array",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenrows",
				"pivot1 derive({isAdmitted } = case(\r",
				"    equalsIgnoreCase(pvt_adm_nonadm_indicator, 'Admitted'), toBoolean('true'),\r",
				"    equalsIgnoreCase(pvt_adm_nonadm_indicator, 'NonAdmitted'), toBoolean('false'),\r",
				"    toBoolean('null')\r",
				"),",
				"          {FileName } = concat(\r",
				"    '/bronze/northernre/treefrog_snapshots/',\r",
				"    pvt_nre_feed,\r",
				"    '/',\r",
				"    pvt_treaty_year,\r",
				"    '/',\r",
				"    $queryDate,\r",
				"    '.parquet'\r",
				")) ~> derivedColumn1",
				"cast1 aggregate(groupBy(pvt_nre_feed,",
				"          pvt_treaty_year,",
				"          pvt_adm_nonadm_indicator,",
				"          pvt_bordereaux_month),",
				"     row_count = count()) ~> aggregate1",
				"cast1, aggregate1 join(pivot1@pvt_nre_feed == aggregate1@pvt_nre_feed",
				"     && pivot1@pvt_adm_nonadm_indicator == aggregate1@pvt_adm_nonadm_indicator",
				"     && cast1@pvt_treaty_year == aggregate1@pvt_treaty_year",
				"     && cast1@pvt_bordereaux_month == aggregate1@pvt_bordereaux_month,",
				"     joinType:'left',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"assert1 select(mapColumn(",
				"          statement_id,",
				"          status,",
				"          nre_feed = pivot1@pvt_nre_feed,",
				"          bordereaux_month = cast1@pvt_bordereaux_month,",
				"          treaty_year = cast1@pvt_treaty_year,",
				"          tf_assumed_paid_ulae = pvt_tf_assumed_paid_ulae,",
				"          tf_assumed_paid_alae = pvt_tf_assumed_paid_alae,",
				"          tf_assumed_collected_premium = pvt_tf_assumed_collected_premium,",
				"          tf_assumed_earned_premium = pvt_tf_assumed_earned_premium,",
				"          tf_assumed_gross_written_premium = pvt_tf_assumed_gross_written_premium,",
				"          tf_assumed_paid_losses = pvt_tf_assumed_paid_losses,",
				"          tf_assumed_expected_losses = pvt_tf_assumed_expected_losses,",
				"          tf_assumed_ss = pvt_tf_assumed_ss,",
				"          v_created = pvt_v_created,",
				"          FileName = {FileName },",
				"          query_date,",
				"          adm_nonadm_indicator = pvt_adm_nonadm_indicator,",
				"          isAdmitted = {isAdmitted },",
				"          program_admin = pvt_program_admin",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"join1 assert(expectTrue(row_count <= 1, false, 'assert1', row_count > 1, \"Unique key check failed\"),",
				"     expectTrue(!isNull(pvt_v_created), false, 'assert2', null, \"Assert that v_created is populated for all rows\"),",
				"     expectTrue(!isNull(query_date), false, 'assert3', null, \"Assert that query_date is populated for all rows\"),",
				"     expectTrue(!isNull(cast1@pvt_bordereaux_month), false, 'assert4', null, \"Assert that bordereaux_month is populated for all rows\"),",
				"     expectTrue(!isNull(pivot1@pvt_nre_feed), false, 'assert5', null, \"Assert that nre_feed is populated for all rows\"),",
				"     expectTrue(!isNull(cast1@pvt_treaty_year), false, 'assert6', null, \"Assert that treaty_year is populated for all rows\"),",
				"     abort: true) ~> assert1",
				"source1 foldDown(unroll(manifest.schema.columns),",
				"     mapColumn(",
				"          statement_id,",
				"          name = manifest.schema.columns.name,",
				"          type_text = manifest.schema.columns.type_text,",
				"          type_name = manifest.schema.columns.type_name,",
				"          position = manifest.schema.columns.position",
				"     ),",
				"     skipDuplicateMapInputs: false,",
				"     skipDuplicateMapOutputs: false) ~> flattenschema",
				"fixColumnNames, window1 join(flattenschema@statement_id == flattenrows@statement_id,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> crossjoin",
				"derivedValue pivot(groupBy(flattenschema@statement_id,",
				"          status,",
				"          rowId,",
				"          query_date),",
				"     pivotBy(fixedName, ['nre_feed', 'bordereaux_month', 'treaty_year', 'tf_assumed_collected_premium', 'tf_assumed_earned_premium', 'tf_assumed_expected_losses', 'tf_assumed_gross_written_premium', 'tf_assumed_paid_alae', 'tf_assumed_paid_losses', 'tf_assumed_paid_ulae', 'tf_assumed_ss', 'v_created', 'adm_nonadm_indicator', 'program_admin']),",
				"     pvt_ = min(value),",
				"     columnNaming: '$N$V',",
				"     lateral: false) ~> pivot1",
				"crossjoin derive(value = case(\r",
				"    upper(type_name) == 'LONG', toString(toLong(rows[position + 1])),\r",
				"    upper(type_name) == 'DOUBLE', toString(toDouble(rows[position + 1])),\r",
				"    or(\r",
				"        upper(type_name) == 'DATE',\r",
				"        in(['v_created', 'bordereaux_month'], fixedName)\r",
				"    ),\r",
				"        toString(case(\r",
				"            !isNull(toDate(rows[position + 1])),\r",
				"            toDate(rows[position + 1]),\r",
				"            toDate(rows[position + 1], 'M/d/yy')\r",
				"        )),\r",
				"    toString(rows[position + 1])\r",
				")) ~> derivedValue",
				"flattenrows window(asc(statement_id, true),",
				"     rowId = rowNumber()) ~> window1",
				"flattenschema derive(fixedName = case(\r",
				"    name == 'bordereau_month', 'bordereaux_month',\r",
				"    name == 'bordereuax_month', 'bordereaux_month',\r",
				"    name\r",
				"),",
				"          query_date = toTimestamp(substring($queryDate, 0, 23) + 'Z', 'yyyy-MM-dd\\'T\\'HH:mm:ss.SSS\\'Z\\'')) ~> fixColumnNames",
				"derivedColumn1 cast(output(",
				"          pvt_bordereaux_month as date,",
				"          pvt_treaty_year as long,",
				"          pvt_tf_assumed_collected_premium as decimal(10,0),",
				"          pvt_tf_assumed_earned_premium as decimal(10,0),",
				"          pvt_tf_assumed_expected_losses as decimal(10,0),",
				"          pvt_tf_assumed_gross_written_premium as decimal(10,0),",
				"          pvt_tf_assumed_paid_alae as decimal(10,0),",
				"          pvt_tf_assumed_paid_losses as decimal(10,0),",
				"          pvt_tf_assumed_paid_ulae as decimal(10,0),",
				"          pvt_tf_assumed_ss as decimal(10,0),",
				"          pvt_v_created as date",
				"     ),",
				"     errors: true) ~> cast1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          nre_feed as string,",
				"          treaty_year as integer,",
				"          v_created as date,",
				"          query_date as timestamp,",
				"          bordereaux_month as date,",
				"          tf_assumed_gross_written_premium as decimal(10,2),",
				"          tf_assumed_earned_premium as decimal(10,2),",
				"          tf_assumed_paid_losses as decimal(10,2),",
				"          tf_assumed_expected_losses as decimal(10,2),",
				"          tf_assumed_collected_premium as decimal(10,2),",
				"          tf_assumed_ss as decimal(10,2),",
				"          tf_assumed_paid_alae as decimal(10,2),",
				"          tf_assumed_paid_ulae as decimal(10,2)",
				"     ),",
				"     format: 'parquet',",
				"     rowUrlColumn:'FileName',",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}