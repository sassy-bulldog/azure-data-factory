{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "jaffa-dev-df"
		},
		"AzureDataLakeStorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'AzureDataLakeStorage'"
		},
		"AzureSQL_NorthernRe_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSQL_NorthernRe'"
		},
		"Development LDS_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'Development LDS'"
		},
		"Azure Databricks_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().BaseURL}"
		},
		"AzureDataLakeStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://developmentdls.dfs.core.windows.net/"
		},
		"AzureKeyVault_NorthernRe_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://NorthernReDatabricks.vault.azure.net/"
		},
		"AzureSQL_NorthernRe_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "noreserver.database.windows.net"
		},
		"AzureSQL_NorthernRe_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "NoreDB"
		},
		"AzureSQL_NorthernRe_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "noreuser"
		},
		"REST_NorthernRe_ServicePrincipal_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "@{linkedService().BaseURL}"
		},
		"REST_NorthernRe_ServicePrincipal_properties_typeProperties_servicePrincipalId": {
			"type": "string",
			"defaultValue": "@{linkedService().ClientID}"
		},
		"REST_NorthernRe_ServicePrincipal_properties_typeProperties_tenant": {
			"type": "string",
			"defaultValue": "@{linkedService().TenantID}"
		},
		"REST_NorthernRe_ServicePrincipal_properties_typeProperties_aadResourceId": {
			"type": "string",
			"defaultValue": "@{linkedService().ResourceID}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "jaffa-dev-df_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureDataLakeStorage_accountKey": {
						"value": "[parameters('AzureDataLakeStorage_accountKey')]"
					},
					"AzureSQL_NorthernRe_password": {
						"value": "[parameters('AzureSQL_NorthernRe_password')]"
					},
					"Development LDS_connectionString": {
						"value": "[parameters('Development LDS_connectionString')]"
					},
					"Azure Databricks_properties_typeProperties_url": {
						"value": "[parameters('Azure Databricks_properties_typeProperties_url')]"
					},
					"AzureDataLakeStorage_properties_typeProperties_url": {
						"value": "[parameters('AzureDataLakeStorage_properties_typeProperties_url')]"
					},
					"AzureKeyVault_NorthernRe_properties_typeProperties_baseUrl": {
						"value": "[parameters('AzureKeyVault_NorthernRe_properties_typeProperties_baseUrl')]"
					},
					"AzureSQL_NorthernRe_properties_typeProperties_server": {
						"value": "[parameters('AzureSQL_NorthernRe_properties_typeProperties_server')]"
					},
					"AzureSQL_NorthernRe_properties_typeProperties_database": {
						"value": "[parameters('AzureSQL_NorthernRe_properties_typeProperties_database')]"
					},
					"AzureSQL_NorthernRe_properties_typeProperties_userName": {
						"value": "[parameters('AzureSQL_NorthernRe_properties_typeProperties_userName')]"
					},
					"REST_NorthernRe_ServicePrincipal_properties_typeProperties_url": {
						"value": "[parameters('REST_NorthernRe_ServicePrincipal_properties_typeProperties_url')]"
					},
					"REST_NorthernRe_ServicePrincipal_properties_typeProperties_servicePrincipalId": {
						"value": "[parameters('REST_NorthernRe_ServicePrincipal_properties_typeProperties_servicePrincipalId')]"
					},
					"REST_NorthernRe_ServicePrincipal_properties_typeProperties_tenant": {
						"value": "[parameters('REST_NorthernRe_ServicePrincipal_properties_typeProperties_tenant')]"
					},
					"REST_NorthernRe_ServicePrincipal_properties_typeProperties_aadResourceId": {
						"value": "[parameters('REST_NorthernRe_ServicePrincipal_properties_typeProperties_aadResourceId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "jaffa-dev-df_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'jaffa-dev-df_ArmTemplate_0')]"
			]
		}
	]
}